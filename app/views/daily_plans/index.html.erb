<div class="page-container"> 
  

  <h1>Historical Insight</h1>
  <p>Review your wellness journey and AI recommendations.</p>

  <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="pills-home-tab" data-bs-toggle="pill" data-bs-target="#pills-home" type="button" role="tab" aria-controls="pills-home" aria-selected="true">This Month</button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="pills-profile-tab" data-bs-toggle="pill" data-bs-target="#pills-profile" type="button" role="tab" aria-controls="pills-profile" aria-selected="false">All Time</button>
    </li>
  </ul>
  <div class="tab-content" id="pills-tabContent">
    <div class="tab-pane fade show active" id="pills-home" role="tabpanel" aria-labelledby="pills-home-tab" tabindex="0">
      <div id="monthly">
        <section class="stats-grid">
          <div class="stat-card">
            <div>
              <h4>Average score</h4>
            </div>
            <div class="score_count">
              <h2>87</h2>
              <span>/ 100</span>
            </div>
            <div>
              <h6>+4% vs last week</h6>
            </div>
          </div>
          <div class="stat-card">
            <div>
              <h4>Best day</h4>
            </div>
            <div>
              <p>Tuesday</p>
            </div>
            <div>
              <h6>92 score</h6>
            </div>
          </div>
        </section>
      </div>
    </div>
    <div class="tab-pane fade" id="pills-profile" role="tabpanel" aria-labelledby="pills-profile-tab" tabindex="0">
      <div id="all-time">
        <section class="stats-grid">
          <div class="stat-card">
            <div>
              <h4>Average score</h4>
            </div>
            <div class="score_count">
              <h2>84</h2>
              <span>/ 100</span>
            </div>
            <div>
              <h6>+1% vs last week</h6>
            </div>
          </div>
          <div class="stat-card">
            <div>
              <h4>Best ever</h4>
            </div>
            <div>
              <p>April 25th</p>
            </div>
            <div>
              <h6>98 score</h6>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>



 <section class="ai-card">
    <div class="ai-icon">
      <i class="fa-solid fa-wand-magic-sparkles"></i>
    </div>
    <h4>AI Observation </h4>
    <p>
      Your scores peak mid-week. Consistent sleep patterns on Monday and Tuesday directly correlate with higher activity levels by Wednesday.
    </p>
  </section>

<%= month_calendar do |date| %>
  <%= date %>
<% end %>

  <ul>
    <% @daily_plans.each do |daily_plan| %>
      <li>
          <ul>
              <li><%= daily_plan.id %></li>
              <li><%= daily_plan.planned_sleep %></li>
              <li><%= daily_plan.planned_workout_duration %></li>
              <li><%= daily_plan.planned_workout_type %></li>
          </ul>
      </li>
    <% end %>
  </ul>
</div>