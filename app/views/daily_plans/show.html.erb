<div class="page-container">

  <section class="score-section breakdown-score-section">
    <h1>Daily Breakdown</h1>
    <h6>Tuesday, Oct 10</h6>

    <div class="score-circle">
      <div>
        <h2>85</h2>
        <span>Overall Score</span>
      </div>
    </div>
  </section>

  <section class="breakdown-grid">

    <div class="stat-card">

      <div class="plan-icon">
        <i class="fa-regular fa-moon"></i>
      </div>

      <h3>Restorative Sleep</h3>

      <p>Phase Focus</p>

      <div class="breakdown-value">
        <strong><%= @daily_plan.actual_sleep %> h</strong>
        <span>Sleep Score</span>
      </div>

    </div>

    <div class="stat-card">

      <div class="plan-icon">
        <i class="fa-solid fa-dumbbell"></i>
      </div>

      <h3>HIIT Session</h3>

      <p><%= @daily_plan.actual_workout_type %></p>

      <div class="breakdown-value">
        <strong><%= @daily_plan.actual_workout_duration %> min</strong>
        <span><%= @daily_plan.workout_feeling %></span>
      </div>

    </div>

    <div class="stat-card">

      <div class="plan-icon">
        <i class="fa-solid fa-utensils"></i>
      </div>

      <h3>Optimal Fuel</h3>

      <p><%= @daily_plan.actual_nutrition %></p>

      <div class="breakdown-value">
        <strong>87</strong>
        <span>Nutrition Score</span>
      </div>

    </div>

  </section>

  <%= link_to edit_daily_plan_path(@daily_plan), class: "checkin-btn breakdown-btn" do %>
    <i class="fa-solid fa-circle-plus"></i>
    Modify Daily Check-in
  <% end %>

</div>
