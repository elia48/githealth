<div class="breakdown-page">
  <div class="breakdown-shell">

    <div class="breakdown-header">
      <h1>Daily Breakdown</h1>
      <p>Tuesday, Oct 10</p>
    </div>

    <section class="breakdown-score-card">
      <div class="score-circle">
      <div>
        <h2>85</h2>
        <span>/ 100</span>
      </div>
    </div>

      <div class="score-legend">
        <span><i class="legend-dot legend-green"></i>Workout</span>
        <span><i class="legend-dot legend-purple"></i>Sleep</span>
        <span><i class="legend-dot legend-yellow"></i>Nutrition</span>
      </div>
    </section>

    <section class="breakdown-grid">
      <div class="breakdown-card">
        <div class="plan-icon">
          <i class="fa-regular fa-moon"></i>
        </div>

        <h3>Restorative Sleep</h3>
        <p class="breakdown-subtitle">Phase Focus</p>

        <p>
          <strong><%= @daily_plan.actual_sleep %> h</strong>
          Sleep Score
        </p>
      </div>

      <div class="breakdown-card">
        <div class="plan-icon">
          <i class="fa-solid fa-dumbbell"></i>
        </div>

        <h3>HIIT Session</h3>
        <p class="breakdown-subtitle"><%= @daily_plan.actual_workout_type %></p>

        <p>
          <strong><%= @daily_plan.actual_workout_duration %> min</strong>
          <%= @daily_plan.workout_feeling %>
        </p>
      </div>

      <div class="breakdown-card">
        <div class="plan-icon">
          <i class="fa-solid fa-utensils"></i>
        </div>

        <h3>Optimal Fuel</h3>
        <p class="breakdown-subtitle"><%= @daily_plan.actual_nutrition %></p>

        <p>
          <strong>87</strong>
          Nutrition Score
        </p>
      </div>
    </section>

    <%= link_to edit_daily_plan_path(@daily_plan), class: "checkin-btn breakdown-checkin-btn" do %>
      <i class="fa-solid fa-circle-plus"></i>
      Modify Daily Check-in
    <% end %>

  </div>
</div>
