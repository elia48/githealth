<div class="page-container">
  <h1>AI Health Assistant</h1>
  <p>Tell the AI what you want to adjust in your daily plan.</p>

  <section class="ai-card">
    <div class="ai-icon">
      <i class="fa-solid fa-wand-magic-sparkles"></i>
    </div>
    <h5>Daily AI Insight</h5>
    <p>
      Great workout yesterday! Try to get
      <strong>30 more minutes of sleep</strong>
      tonight to optimize recovery.
    </p>
  </section>

  <div class="brillo-border">
    <section class="plan-card mb-0">
      <div class="plan-item">
        <div class="plan-icon">
          <i class="fa-regular fa-moon"></i>
        </div>
        <div class="w-100">
          <h4>Sleep Plan</h4>
        </div>
      </div>
          <div>
            <div class="d-flex justify-content-around mt-3">
              <div>
                <h5>TARGET BEDTIME</h5>
                <p>10:30 P.M</p>
              </div>
              <div><i class="fa-solid fa-arrow-right"></i></div>
              <div>
                <h5>TARGET WAKE</h5>
                <p>6 :30 A.M.</p>
              </div>
            </div>
            <div class="progress-bar mt-3">
              <div class="progress-fill-100"></div>
            </div>
            <p><%= @daily_plan.planned_sleep %>h optimal duration based on routine.</p>
          </div>
    </section>
  </div>

  <div class="brillo-border">
    <section class="plan-card mb-0">
      <div class="plan-item">
        <div class="plan-icon">
          <i class="fa-solid fa-dumbbell"></i>
        </div>
        <div class="w-100">
          <h4>Workout Plan</h4>
        </div>
      </div>
          <div class="d-flex justify-content-around mt-3">
            <div>
              <div>
              <h5><%= @daily_plan.planned_workout_type %></h5>
              </div>
            </div>
            <div><i class="fa-solid fa-arrow-right"></i></div>
            <div>
              <h5><%= @daily_plan.planned_workout_duration %>m</h5>
            </div>
          </div>
          <div class="mt-3"><p>Based on your fatigue levels, today should be a <%= @daily_plan.planned_workout_type %> workout.</p>
          </div>
    </section>
  </div>

  <div class="brillo-border">
    <section class="plan-card mb-0">
      <div class="plan-item">
        <div class="plan-icon">
          <i class="fa-solid fa-utensils"></i>
        </div>
        <div class="w-100">
          <h4>Nutrition Plan</h4>
        </div>
      </div>
          <div>
            <p>Recommended nutrition for recovery.</p>
          </div>
          <div class="justify-content-around mt-3">
            <div>
              <h5><%= @daily_plan.planned_nutrition_log %></h5>
          </div>
    </section>
  </div>

  <div class="chatbox p-3 mt-5 mb-5 d-flex flex-column">
    <div class="flex-grow-1 overflow-auto ">
      <% @messages.each do |message| %>

  <section class="ai-card mt-4">

    <h4>
      <%= message.role == "user" ? "You" : "AI Response" %>
    </h4>

    <p>
      <%= simple_format(message.content.gsub("READY_FOR_CONFIRMATION", "")) %>
    </p>

    <% if message.role == "assistant" && message.content.include?("READY_FOR_CONFIRMATION") %>

      <%= button_to "Confirm Plan",
        confirm_ai_plan_daily_plan_path(@daily_plan),
        data: { turbo_method: :patch },
        class: "checkin-btn" %>

    <% end %>

  </section>

<% end %>  
    </div>
   <%= simple_form_for :chat,
    url: ask_ai_daily_plan_path(@daily_plan),
    method: :post do |f| %>
<label class="form-label string required" for="chat_message">What do you want to change?</label>
<div class="input-group border rounded-pill p-1">
    <%= f.input :message, class: "text-light",
      placeholder: "Example: I actually slept 6 hours and did 30 min of walking",
      wrapper: false, label: false,
      input_html: { value: params.dig(:chat, :message), class: "chat-placeholder border-0 bg-transparent text-light"} %>
    <%= f.button :button, class: "chat-btn rounded-circle z-0" do %>
    <i class="fa-solid fa-paper-plane"></i>
    <% end %>
  <% end %>
    </div>

  <% if @ai_response.present? %>
    <div class="ai-card mt-4">
      <h4>AI response</h4>
      <p><%= @ai_response %></p>
    </div>
  <% end %>
  </div>
  <div class="text-center">____</div>
</div>

